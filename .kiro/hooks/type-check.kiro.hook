{
  "enabled": true,
  "name": "TypeScript Type Check",
  "description": "Run TypeScript type checking after editing .ts/.tsx files",
  "version": "1.0.0",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run TypeScript type checking on the edited file using `npx tsc --noEmit`. Report any type errors found in the file."
  }
}
